# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# jeton MCP, local uniquement
.mcp-token.local.txt

# design-reference/ ne garde que les maquettes HTML/CSS.
# Le runtime de l'editeur Claude Design et sa vignette sont reimportes
# a chaque export du zip : inutile de les versionner.
design-reference/support.js
design-reference/.thumbnail
